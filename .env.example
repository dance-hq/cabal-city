# Supabase (Project Settings → API). The anon key is public; the others are server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used to hash sign-in rate-limit records. Project Settings → API → JWT secret.
SUPABASE_JWT_SECRET=
# Direct (non-pooling) Postgres connection, used only by `pnpm db:migrate` / `pnpm db:seed`.
POSTGRES_URL_NON_POOLING=

# Email sign-in codes. Without a key, codes print to the dev server log (development only).
RESEND_API_KEY=
CABAL_EMAIL_FROM="Cabal <hello@your-domain.com>"

# Which community this server runs (matches the slug in supabase/seed.sql).
NEXT_PUBLIC_CABAL_COMMUNITY=chicago
# Comma-separated emails that become admins when they join.
CABAL_ADMIN_EMAILS=
# Optional: forward mail sent to your domain (receiving turned on in Resend)
# to a real inbox. Needs a full-access Resend key; RESEND_API_KEY can stay
# send-only. The webhook secret comes from Resend's email.received webhook,
# pointed at /api/email/inbound.
# RESEND_INBOUND_KEY=
# RESEND_WEBHOOK_SECRET=
# CABAL_FORWARD_TO=you@gmail.com
# Optional: the team that builds your Cabal, suggested first to new members.
# NEXT_PUBLIC_CABAL_MAKERS_TEAM="Your Team"

# Public address of this site, and the GitHub repo whose releases hold the desktop installers.
NEXT_PUBLIC_CABAL_APP_URL=https://cabal.example.com
NEXT_PUBLIC_CABAL_GITHUB_REPO=your-org/cabal-city
